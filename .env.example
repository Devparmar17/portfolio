# Copy to .env.local and fill in to make the contact form deliver email.
#
# Without RESEND_API_KEY the form does not pretend to work: the visitor sees
# "Something went wrong. Please try again." and the server logs why.
#
# 1. Create a free key at https://resend.com/api-keys
# 2. Paste it below (this stays on the server — never exposed to the browser)
# 3. On Vercel add the same variable under Settings -> Environment Variables
RESEND_API_KEY=

# Optional. Where messages are delivered.
# Defaults to the address in data/portfolio.js.
CONTACT_TO_EMAIL=

# Optional. The "from" address on the email.
# Defaults to Resend's shared test sender, which can only deliver to the
# address that owns the Resend account — fine to start with. To send from
# your own domain, verify it at https://resend.com/domains and set e.g.
# CONTACT_FROM_EMAIL="Portfolio <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=

# Optional. Set once you have a custom domain, so canonical and Open Graph
# URLs point at it. Vercel's production URL is used automatically otherwise.
NEXT_PUBLIC_SITE_URL=
