# Copy to .env.local and fill in to enable real contact-form delivery.
#
# Leave this unset and the form still works: it validates, then opens the
# visitor's mail client with the message pre-filled.
#
# Formspree:  https://formspree.io/f/xxxxxxx
# Resend / custom API route: point at your own endpoint that accepts
#   POST { name, email, message } as JSON.
NEXT_PUBLIC_FORM_ENDPOINT=
